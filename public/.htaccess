# =====================================================================
# COSMOOSS — Apache configuration (Hostinger / hébergement mutualisé)
# ---------------------------------------------------------------------
# Équivalent du nginx/default.conf pour un hébergement Apache/LiteSpeed
# (Hostinger hpanel). Vite copie ce fichier dans dist/ (.htaccess).
#
# Déploiement : uploader le CONTENU de dist/ dans public_html/.
#   npm run build && npm run prerender   (ou: docker compose build)
#   → public_html/index.html, assets/, prerendered/, sitemap.xml,
#     robots.txt, .htaccess
#
# Domaine : https://cosmooss.com — le SSL gratuit Hostinger est déjà actif
# (https forcé ci-dessous).
# =====================================================================

# Pas de listing de dossier ; désactiver la négociation multi-vues (casse le SPA).
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Forcer HTTPS (le certificat SSL est actif).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Pages produit prérendues pour les robots (aperçus WhatsApp/Facebook,
  #    SEO Google). Le HTML statique n'est servi QUE s'il existe : sinon la
  #    requête retombe sur la SPA (404 React noindex), jamais d'erreur 500.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|twitterbot|whatsapp|telegrambot|linkedinbot|googlebot|bingbot|pinterest|slackbot|discordbot|discord|slack|vkshare|baiduspider|yandexbot) [NC]
  RewriteCond %{DOCUMENT_ROOT}/prerendered/produit/$1/index.html -f
  RewriteRule ^produit/([^/]+)/?$ prerendered/produit/$1/index.html [L]

  # 3) Repli SPA : toute route React → index.html. Les fichiers réels
  #    (assets hashés, /prerendered/*, sitemap.xml, robots.txt) sont servis
  #    directement (les deux conditions ci-dessous les laissent passer).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------
# Types MIME
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------
# Compression (texte uniquement — images/woff2 déjà compressés)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------
# Expiration / cache
#   * assets hashés → immutable 1 an
#   * index.html → jamais caché (reprendre les nouveaux hashes au déploiement)
#   * robots.txt / sitemap.xml → cache court
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # En-têtes de sécurité — miroir strict de nginx/security-headers.inc.
  # (CSP : mêmes origines que la config Nginx — Supabase, Sentry, Google Fonts,
  #  Google Maps/YouTube, Nominatim. Mettre à jour ici si un domaine est ajouté.)
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co https://*.sentry.io https://nominatim.openstreetmap.org; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---------------------------------------------------------------------
# Refuser l'accès aux fichiers sensibles éventuels
# ---------------------------------------------------------------------
<FilesMatch "^\.(env|git|htaccess\.example)">
  Require all denied
</FilesMatch>
