VITE_SENTRY_ENVIRONMENT="production"
# ─────────────────────────────────────────────────────────────
# TEST DE CHARGE k6 (scripts/k6-load-test.js)
# Ces variables ne sont PAS lues par l'application — seulement
# par la commande k6 (sans aucun secret service_role).
# ─────────────────────────────────────────────────────────────
# URL du projet Supabase DÉDIÉ AUX TESTS (jamais la production).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé "anon" du projet de test (publique, sûre à exposer).
SUPABASE_ANON_KEY=eyJhbGciOi...

# Compte authentifié créé dans le projet de test,
# utilisé par les scénarios auth + commandes de test.
# ⚠️ AUCUN mot de passe réel : remplacer par un compte de test dédié.
SUPABASE_TEST_EMAIL=test@example.com
SUPABASE_TEST_PASSWORD=REPLACE_WITH_TEST_PASSWORD

# Charge du test k6 (free plan : rester ≤ 40).
MAX_VUS=20
DURATION=2m

# ─────────────────────────────────────────────────────────────
# SUPABASE DASHBOARD — configuration requise une seule fois
# (voir SCALABILITY_SECURITY_VERIFICATION.md pour le détail)
#   • Authentication → Providers → Email : laisser l'option "Allow new
#     users to sign up" DÉSACTIVÉE — il n'y a AUCUNE inscription publique.
#   • Créer les comptes admin manuellement : Authentication → Users →
#     Create user (email + mot de passe).
#   • SQL Editor : exécuter supabase/database.sql (idempotent). Ce fichier
#     crée la table public.admin_users (allowlist) et la fonction
#     public.is_admin(). Un compte Auth n'est ADMIN que si son UUID est
#     présent dans public.admin_users (seed initial : tous les comptes
#     Auth existants au premier déploiement).
#   • Gérer l'allowlist : SQL Editor (INSERT/DELETE dans admin_users) —
#     jamais depuis le navigateur (RLS sans policy, accès anon/authenticated
#     révoqués).
# ─────────────────────────────────────────────────────────────
